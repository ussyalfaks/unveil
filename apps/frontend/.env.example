# The deployed Unveil contract (scripts/deploy.sh prints it).
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_TOKEN_SYMBOL=XLM
# testnet (default) or mainnet
NEXT_PUBLIC_NETWORK=testnet
# Optional: where the storage API keeps encrypted files locally (default ./data).
# DATA_DIR=/var/data/unveil
# On Vercel: connect a Blob store to the project and BLOB_READ_WRITE_TOKEN is set
# for you; storage then uses Vercel Blob instead of the disk.
# BLOB_ACCESS=private   # default; use "public" only if your Blob store is public
